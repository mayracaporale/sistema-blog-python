
ESTADOS_VALIDOS = ["Publicado", "Borrador"]


class Autor:
    def __init__(self, nombre, bio=""):
        self.nombre = nombre
        self.bio = bio


class Post:
    def __init__(self, id, titulo, contenido, autor, tags, estado):
        self.id = id
        self.titulo = titulo
        self.contenido = contenido
        self.autor = autor
        self.tags = tags
        self.estado = estado

    def validar(self):
        return (
            isinstance(self.id, int)
            and self.id > 0
            and bool(self.titulo.strip())
            and bool(self.contenido.strip())
            and isinstance(self.autor, Autor)
            and bool(self.autor.nombre.strip())
            and isinstance(self.tags, list)
            and all(
                isinstance(tag, str) and bool(tag.strip())
                for tag in self.tags
            )
            and self.estado in ESTADOS_VALIDOS
        )


class Blog:
    def __init__(self, posts=None):
        self.posts = posts if posts is not None else []

    def listar_posts(self):
        return self.posts

    def obtener_posts(self):
        return self.posts

    def buscar_por_titulo(self, termino):
        return [
            post for post in self.posts
            if termino.lower() in post.titulo.lower()
        ]

    def filtrar_por_tag(self, tag):
        return [
            post for post in self.posts
            if any(etiqueta.lower() == tag.lower()
                   for etiqueta in post.tags)
        ]

    def crear_post(self, titulo, contenido, autor, tags):
        if not titulo.strip():
            raise ValueError("El título es obligatorio.")

        if not contenido.strip():
            raise ValueError("El contenido es obligatorio.")

        if not isinstance(autor, Autor) or not autor.nombre.strip():
            raise ValueError("El autor es obligatorio.")

        nuevo_id = max(
            (post.id for post in self.posts),
            default=0
        ) + 1

        nuevo_post = Post(
            nuevo_id, titulo, contenido, autor, tags, "Borrador"
        )

        self.posts.append(nuevo_post)
        return nuevo_post

    def validar_posts(self):
        return [(post, post.validar()) for post in self.posts]
